{
  "name": "vyaguta-api-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Postman/Newman API test suite for the Vyaguta API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "node -e \"const fs=require('fs'),path=require('path');['collections/vyaguta-api.postman_collection.json',...fs.readdirSync('environments').map(f=>path.join('environments',f))].forEach(f=>JSON.parse(fs.readFileSync(f,'utf8')))\"",
    "pretest": "npm run lint",
    "test": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/report.html",
    "pretest:ci": "npm run lint",
    "test:ci": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --env-var \"authToken=$VYAGUTA_TOKEN\" --reporters cli,junit --reporter-junit-export reports/junit-report.xml",
    "test:sanity": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder Sanity --reporters cli,htmlextra --reporter-htmlextra-export reports/sanity-report.html",
    "test:health": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder Health --reporters cli,htmlextra --reporter-htmlextra-export reports/health-report.html",
    "test:people": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder People --reporters cli,htmlextra --reporter-htmlextra-export reports/people-report.html",
    "test:team": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder Team --reporters cli,htmlextra --reporter-htmlextra-export reports/team-report.html",
    "test:attendance": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder Attendance --reporters cli,htmlextra --reporter-htmlextra-export reports/attendance-report.html",
    "test:jump": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder JUMP --reporters cli,htmlextra --reporter-htmlextra-export reports/jump-report.html",
    "test:honor": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder Honor --reporters cli,htmlextra --reporter-htmlextra-export reports/honor-report.html",
    "test:okr": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder OKR --reporters cli,htmlextra --reporter-htmlextra-export reports/okr-report.html",
    "test:pulse": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --folder Pulse --reporters cli,htmlextra --reporter-htmlextra-export reports/pulse-report.html"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
