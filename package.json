{
  "name": "vyaguta-api-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Postman/Newman API test suite for the Vyaguta API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "node scripts/lint-all.js",
    "split": "node scripts/split-collections.js",
    "pretest": "npm run lint",
    "test": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/report.html",
    "test:ci": "newman run collections/vyaguta-api.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,junit,htmlextra --reporter-junit-export reports/junit-report.xml --reporter-htmlextra-export reports/report.html",
    "test:sanity": "newman run collections/modules/sanity.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/sanity-report.html",
    "test:health": "newman run collections/modules/health.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/health-report.html",
    "test:people": "newman run collections/modules/people.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/people-report.html",
    "test:teams": "newman run collections/modules/teams.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/teams-report.html",
    "test:attendance": "newman run collections/modules/attendance.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/attendance-report.html",
    "test:jump": "newman run collections/modules/jump.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/jump-report.html",
    "test:honor": "newman run collections/modules/honor.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/honor-report.html",
    "test:okr": "newman run collections/modules/okr.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/okr-report.html",
    "test:pulse": "newman run collections/modules/pulse.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/pulse-report.html",
    "test:core": "newman run collections/modules/core.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/core-report.html",
    "test:edge": "newman run collections/modules/edge-cases.postman_collection.json -e environments/vyaguta.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/edge-report.html"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
