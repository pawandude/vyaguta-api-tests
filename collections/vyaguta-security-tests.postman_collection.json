        {
          "name": "Special characters in POST body — no 500, no DB error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"subjectId\":15444,\"noteType\":\"FEEDBACK\",\"note\":\"[SEC-TEST] Special chars: ' OR 1=1; DROP TABLE notes; -- \\\"inject\\\"\",\"noteStatus\":\"ACTIVE\",\"notePrivacy\":\"ONLY_ME\",\"areaId\":4}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/pulse/notes/feedback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pulse",
                "notes",
                "feedback"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Special chars in POST body: not a 500 server error', function () {",
                  "    pm.expect(pm.response.code).to.not.equal(500, 'Server 500 on special chars — possible injection or unhandled exception');",
                  "});",
                  "pm.test('Special chars in POST body: no DB error keywords in response', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.not.include('syntax error');",
                  "    pm.expect(text).to.not.include('pg_query');",
                  "    pm.expect(text).to.not.include('unterminated');",
                  "    pm.expect(text).to.not.include('drop table');",
                  "});",
                  "pm.test('Special chars in POST body: returns 200/201 (stored safely) or 400/422 (rejected)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 403, 422]);",
                  "});",
                  "// Cleanup: store the created note id if the request succeeded, for deletion in teardown",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    try {",
                  "        const body = pm.response.json();",
                  "        const id = (body.data && body.data.id) || body.id;",
                  "        if (id) pm.environment.set('secTestNoteId', id);",
                  "    } catch(e) {}",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Path traversal in ID — no file system exposure",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users/..%2F..%2Fetc%2Fpasswd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users",
                "..%2F..%2Fetc%2Fpasswd"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
