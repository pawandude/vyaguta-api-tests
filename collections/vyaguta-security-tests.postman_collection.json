{
  "info": {
    "name": "Vyaguta API Security Tests",
    "description": "Security test suite aligned with the Leapfrog QA Security Testing KSS (September 2026). Covers Tier 1 (auth, sensitive data, XSS/injection, session), Tier 2 (API security, SQLi), and Tier 3 (security headers). Run against DEV only. All tokens supplied via environment variables — no hardcoded credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Tier 1-A — Authentication & Authorization",
      "description": "Verify that all protected endpoints enforce authentication and role boundaries hold under direct API manipulation.",
      "item": [
        {
          "name": "Expired JWT is rejected — 401",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IlRlc3QgVXNlciIsImlhdCI6MTUxNjIzOTAyMiwiZXhwIjoxNTE2MjM5MDIyfQ.4Adcj3UFYzPUVaVF43FmMze9L95gD-LNB0nNLgAJz9k",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expired JWT returns 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Error response does not expose internal server detail', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.not.include('stack');",
                  "    pm.expect(text).to.not.include('exception');",
                  "    pm.expect(text).to.not.include('traceback');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Restricted token cannot create resource — 403",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{restrictedToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"[SEC-TEST] Unauthorized create attempt\",\"description\":\"Security test\",\"redirectUrl\":\"https://dev.vyaguta.lftechnology.com.np\",\"startDate\":\"2026-10-07T00:00:00.000Z\",\"endDate\":\"2026-10-08T00:00:00.000Z\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/core/reminders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "reminders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Restricted token cannot write — 403 or 401', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  "pm.test('Response does not confirm resource creation', function () {",
                  "    if (pm.response.code === 200 || pm.response.code === 201) {",
                  "        pm.expect.fail('Write operation succeeded with restricted token — access control failure');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Restricted token cannot delete resource — 403",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{restrictedToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/reminders/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "reminders",
                "999999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Restricted token cannot delete — 401 or 403 (not 404 which would mean auth passed)', function () {",
                  "    // 404 would mean the request was authorized and the resource just wasn't found",
                  "    // 401/403 is the expected security boundary response",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "IDOR — access another user's roles returns no escalation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users/1/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users",
                "1",
                "roles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('IDOR check: accessing another user roles returns 403/404 or is scoped', function () {",
                  "    // Acceptable outcomes:",
                  "    // 403 — server correctly restricts cross-user access",
                  "    // 404 — user does not exist at that ID",
                  "    // 200 — admin token is allowed to read any user; record this result",
                  "    const allowed = [200, 403, 404];",
                  "    pm.expect(pm.response.code).to.be.oneOf(allowed, 'Unexpected status ' + pm.response.code);",
                  "});",
                  "pm.test('Response is not a 500 server error', function () {",
                  "    pm.expect(pm.response.code).to.not.equal(500);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Non-existent user ID returns 404 not data of another user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users",
                "999999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Non-existent ID returns 404 — no data substitution', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Response body does not contain valid user data', function () {",
                  "    const body = pm.response.json();",
                  "    const data = body.data;",
                  "    pm.expect(data).to.satisfy(function(d) {",
                  "        return d === null || d === undefined || (Array.isArray(d) && d.length === 0);",
                  "    }, 'Data should be null/undefined/empty for a non-existent resource');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Tier 1-B — Sensitive Data Exposure",
      "description": "Ensure confidential information is never returned in API responses, headers, or error messages.",
      "item": [
        {
          "name": "User list response contains no password fields",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users?sortBy=firstName&order=ASC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "firstName"
                },
                {
                  "key": "order",
                  "value": "ASC"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response contains no password fields', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    // Check for any password-related field names",
                  "    pm.expect(text).to.not.match(/\"password\"\\s*:/i, 'password field found in response');",
                  "    pm.expect(text).to.not.match(/\"passwd\"\\s*:/i, 'passwd field found in response');",
                  "    pm.expect(text).to.not.match(/\"pwd\"\\s*:/i, 'pwd field found in response');",
                  "});",
                  "pm.test('Response contains no raw auth token values', function () {",
                  "    const text = pm.response.text();",
                  "    const token = pm.environment.get('authToken') || '';",
                  "    if (token.length > 20) {",
                  "        pm.expect(text).to.not.include(token, 'Auth token should not appear in response body');",
                  "    }",
                  "});",
                  "pm.test('Response contains no secret/private key fields', function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.match(/\"secret\"\\s*:/i, 'secret field found in response');",
                  "    pm.expect(text).to.not.match(/\"private_key\"\\s*:/i, 'private_key field found in response');",
                  "    pm.expect(text).to.not.match(/\"api_key\"\\s*:/i, 'api_key field found in response');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "404 error response exposes no stack trace",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users",
                "999999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Error response does not expose stack trace', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.not.include('at line ', 'Stack trace line reference exposed');",
                  "    pm.expect(text).to.not.include('traceback', 'Python traceback exposed');",
                  "    pm.expect(text).to.not.include('exception in thread', 'Java exception trace exposed');",
                  "    pm.expect(text).to.not.include('syntaxerror', 'Syntax error exposed');",
                  "});",
                  "pm.test('Error response does not expose internal file paths', function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.match(/\\/home\\/|C:\\\\|var\\/www|node_modules/i, 'Internal server path exposed in error response');",
                  "});",
                  "pm.test('Error response does not expose database names or query info', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.not.include('postgresql', 'DB type exposed in error');",
                  "    pm.expect(text).to.not.include('mysql', 'DB type exposed in error');",
                  "    pm.expect(text).to.not.include('select ', 'Raw SQL exposed in error');",
                  "    pm.expect(text).to.not.include('from public.', 'DB schema exposed in error');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Response headers do not expose server technology",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Powered-By header is absent (technology stack not exposed)', function () {",
                  "    pm.expect(pm.response.headers.get('X-Powered-By')).to.not.exist;",
                  "});",
                  "pm.test('Server header does not expose version number', function () {",
                  "    const server = pm.response.headers.get('Server') || '';",
                  "    // A plain 'nginx' or 'apache' without version is acceptable",
                  "    // 'nginx/1.18.0' or 'Apache/2.4.52' is a finding",
                  "    pm.expect(server).to.not.match(/\\/\\d+\\.\\d+/, 'Server header exposes version: ' + server);",
                  "});",
                  "pm.test('No internal debug headers present', function () {",
                  "    pm.expect(pm.response.headers.get('X-Debug')).to.not.exist;",
                  "    pm.expect(pm.response.headers.get('X-Debug-Token')).to.not.exist;",
                  "    pm.expect(pm.response.headers.get('X-Symfony-Debug')).to.not.exist;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
