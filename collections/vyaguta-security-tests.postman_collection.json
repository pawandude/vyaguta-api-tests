    {
      "name": "Tier 1-C + Tier 2-F — Injection Attacks",
      "description": "Send SQL injection payloads to query parameters and special characters to POST body fields. Verify the API handles them safely — no DB errors in responses, no 500s. XSS is a browser/UI concern and is not tested here.",
      "item": [
        {
          "name": "SQLi in sortBy param — no DB error, not 500",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users?sortBy=' OR '1'='1&order=ASC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "' OR '1'='1"
                },
                {
                  "key": "order",
                  "value": "ASC"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('SQLi in sortBy: not a 500 server error', function () {",
                  "    pm.expect(pm.response.code).to.not.equal(500, 'Server returned 500 — possible injection handling failure');",
                  "});",
                  "pm.test('SQLi in sortBy: no raw database error in response', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.not.include('syntax error', 'DB syntax error exposed');",
                  "    pm.expect(text).to.not.include('ora-', 'Oracle error exposed');",
                  "    pm.expect(text).to.not.include('mysql', 'MySQL error exposed in body');",
                  "    pm.expect(text).to.not.include('pg_query', 'PostgreSQL query function exposed');",
                  "    pm.expect(text).to.not.include('unterminated quoted string', 'Raw SQL error exposed');",
                  "});",
                  "pm.test('SQLi in sortBy: safe status returned', function () {",
                  "    // 200 (input ignored/sanitized), 400 (input rejected) or 422 are all acceptable",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 403, 422]);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "SQLi in year param — no DB error, not 500",
          "request": {
            "method": "GET",
            "header": [],
