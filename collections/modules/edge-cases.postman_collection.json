{
  "info": {
    "name": "Vyaguta — Behavior & Edge Cases",
    "description": "Module tests: Behavior & Edge Cases. Part of the Vyaguta API test suite.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Behavior & Edge Cases",
      "description": "Auth negative tests and known API quirks. Auth role coverage to be expanded once user roles are confirmed.",
      "item": [
        {
          "name": "Missing token returns 401",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid token returns 401",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid-token",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-existent user pulse returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pulse/user/999999999/pulse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pulse",
                "user",
                "999999999",
                "pulse"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 (API returns 400 for non-existent user pulse, not 404)', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Response time is below 5000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Non-existent honor campaign appreciations returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/honor/users/{{personId}}/campaigns/00000000-0000-0000-0000-000000000000/appreciations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "honor",
                "users",
                "{{personId}}",
                "campaigns",
                "00000000-0000-0000-0000-000000000000",
                "appreciations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400, 403, or 404 (Honor access or campaign not found)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 403, 404]);",
                  "});",
                  "pm.test('Response time is below 5000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Non-existent OKR year returns empty data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/okr/strategic-pillars/summary?year=1900",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "okr",
                "strategic-pillars",
                "summary?year=1900"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Data is empty for non-existent year', function () {",
                  "    const body = pm.response.json();",
                  "    const data = body.data;",
                  "    pm.expect(data).to.satisfy(function (d) {",
                  "        return d === null || (Array.isArray(d) && d.length === 0) || (typeof d === 'object' && Object.keys(d).length === 0);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Non-existent user roles returns 200 empty (quirk — API does not validate user existence)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users/999999999/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users",
                "999999999",
                "roles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (quirk: API does not 404 for non-existent user roles)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time is below 5000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response body is empty (no roles for non-existent user)', function () {",
                  "    const body = pm.response.json();",
                  "    const data = body.data !== undefined ? body.data : body;",
                  "    const isEmpty = data === null",
                  "        || (Array.isArray(data) && data.length === 0)",
                  "        || (typeof data === 'object' && !Array.isArray(data) && Object.keys(data).length === 0);",
                  "    pm.expect(isEmpty).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Restricted user cannot create reminder returns 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/core/reminders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "reminders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{restrictedToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"test\",\"description\":\"test\",\"redirectUrl\":\"https://test.com\",\"startDate\":\"2026-10-07T00:00:00.000Z\",\"endDate\":\"2026-10-08T00:00:00.000Z\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 — restricted role cannot perform this action', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Response time is below 5000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
