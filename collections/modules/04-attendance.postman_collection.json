{
  "info": {
    "name": "Vyaguta — Attendance",
    "description": "Module tests: Attendance. Part of the Vyaguta API test suite.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Attendance",
      "description": "Tests for the Attendance module — /api/leave/attendance/summary with fetchType=self and fetchType=team.",
      "item": [
        {
          "name": "Get attendance summary for self returns 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave/attendance/summary?fetchType=self",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave",
                "attendance",
                "summary"
              ],
              "query": [
                {
                  "key": "fetchType",
                  "value": "self"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['data'],",
                  "  properties: {",
                  "    data: {",
                  "      type: 'object',",
                  "      required: ['leave', 'worklog', 'missing'],",
                  "      properties: {",
                  "        leave: {",
                  "          type: 'object',",
                  "          properties: { approved: { type: 'integer' } }",
                  "        },",
                  "        worklog: {",
                  "          type: 'object',",
                  "          properties: { pending: { type: 'integer' } }",
                  "        },",
                  "        missing: { type: 'integer' }",
                  "      }",
                  "    }",
                  "  }",
                  "};",
                  "pm.test(\"Response matches schema\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "pm.test(\"data has leave, worklog, missing\", function () {",
                  "    const attendanceData = pm.response.json().data;",
                  "    pm.expect(attendanceData).to.have.all.keys('leave', 'worklog', 'missing');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get attendance summary for team returns 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave/attendance/summary?fetchType=team",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave",
                "attendance",
                "summary"
              ],
              "query": [
                {
                  "key": "fetchType",
                  "value": "team"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['data'],",
                  "  properties: {",
                  "    data: {",
                  "      type: 'object',",
                  "      required: ['leave', 'worklog', 'missing'],",
                  "      properties: {",
                  "        leave:   { type: 'object' },",
                  "        worklog: { type: 'object' },",
                  "        missing: { type: 'integer' }",
                  "      }",
                  "    }",
                  "  }",
                  "};",
                  "pm.test(\"Response matches schema\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "pm.test(\"missing count is a non-negative integer\", function () {",
                  "    pm.expect(pm.response.json().data.missing).to.be.at.least(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get attendance summary with invalid fetchType returns 200 or 400 (quirk)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave/attendance/summary?fetchType=invalid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave",
                "attendance",
                "summary"
              ],
              "query": [
                {
                  "key": "fetchType",
                  "value": "invalid"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 400\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "",
      "type": "string"
    }
  ]
}