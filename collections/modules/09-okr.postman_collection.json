        {
          "name": "Get HLOs for all quarters returns 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/okr/hlo?quarters=Q1,Q2,Q3,Q4&with=objectives&year=2026",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "okr",
                "hlo"
              ],
              "query": [
                {
                  "key": "quarters",
                  "value": "Q1,Q2,Q3,Q4"
                },
                {
                  "key": "with",
                  "value": "objectives"
                },
                {
                  "key": "year",
                  "value": "2026"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test(\"All quarters represented in results\", function () {",
                  "    const quarters = pm.response.json().data.map(function (hlo) { return hlo.quarter; });",
                  "    const unique = [...new Set(quarters)];",
                  "    pm.expect(unique.length).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
