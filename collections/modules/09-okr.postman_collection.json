                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['data'],",
                  "  properties: {",
                  "    data: {",
                  "      type: 'array',",
                  "      items: {",
                  "        type: 'object',",
                  "        required: ['id', 'code', 'title', 'quarter'],",
                  "        properties: {",
                  "          id:      { type: 'integer' },",
                  "          code:    { type: 'string' },",
                  "          title:   { type: 'string' },",
                  "          quarter: { type: 'string' },",
                  "          area: {",
                  "            type: 'object',",
                  "            properties: {",
                  "              id:   { type: 'integer' },",
