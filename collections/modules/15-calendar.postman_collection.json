            ],
            "url": {
              "raw": "{{baseUrl}}/api/leave/calendar?fetchType=team&startDate=2026-10-05&endDate=2026-10-25&worklog=false&includeFutureLeaves=true&skipPagination=true&withExpectedRosterAndWorkingShift=true&roleType=manager&userIds=&userId=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave",
                "calendar"
              ],
              "query": [
                {
                  "key": "fetchType",
                  "value": "team"
                },
                {
                  "key": "startDate",
                  "value": "{{currentMonthStart}}"
                },
                {
                  "key": "endDate",
                  "value": "{{currentMonthEnd}}"
                },
                {
                  "key": "worklog",
                  "value": "false"
                },
                {
                  "key": "includeFutureLeaves",
                  "value": "true"
                },
                {
                  "key": "skipPagination",
                  "value": "true"
                },
                {
                  "key": "withExpectedRosterAndWorkingShift",
                  "value": "true"
                },
                {
                  "key": "roleType",
                  "value": "manager"
                },
                {
                  "key": "userIds",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "userId",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 2xx', function() { pm.response.to.be.success; });",
                  "pm.test('Response time is below 5000ms', function() { pm.expect(pm.response.responseTime).to.be.below(5000); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
