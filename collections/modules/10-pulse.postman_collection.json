                  "  required: ['data', 'message'],",
                  "  properties: {",
                  "    message: { type: 'string' },",
                  "    data: {",
                  "      type: 'object',",
                  "      required: ['helpRequests', 'pip', 'probations'],",
                  "      properties: {",
                  "        helpRequests: { type: 'array' },",
                  "        pip:          { type: 'array' },",
                  "        probations: {",
