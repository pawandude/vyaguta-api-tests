      "name": "Pulse",
      "description": "Tests for the Pulse module (surveys, feedback).",
      "item": [
        {
          "name": "Get pulse dashboard returns 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pulse/dashboard?startDate=2026-10-01&endDate=2026-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pulse",
                "dashboard"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-10-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-12-31"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['data'],",
                  "  properties: {",
                  "    data: {",
                  "      type: 'array',",
                  "      items: {",
                  "        type: 'object',",
                  "        required: ['id', 'relation', 'noteStatus'],",
                  "        properties: {",
                  "          id:         { type: 'integer' },",
                  "          relation:   { type: 'string' },",
                  "          noteStatus: { type: 'string' },",
                  "          subject:    { type: ['object', 'null'] },",
                  "          appraiser:  { type: ['object', 'null'] }",
                  "        }",
                  "      }",
                  "    }",
                  "  }",
                  "};",
                  "pm.test(\"Response matches schema\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});"
                ]
              }
            }
          ]
        },
