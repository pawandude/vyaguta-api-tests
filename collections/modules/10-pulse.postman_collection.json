                  "value": "{{personId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const noteSchema = {",
                  "  type: 'object',",
                  "  required: ['id', 'noteType', 'subjectId'],",
                  "  properties: {",
                  "    id:                   { type: 'integer' },",
                  "    allocationId:         { type: ['integer', 'null'] },",
                  "    isClosingFeedback:    { type: 'integer' },",
                  "    note:                 { type: ['string', 'null'] },",
                  "    noteExpectations:     { type: 'array' },",
                  "    isDeletable:          { type: 'boolean' },",
                  "    ratings:              { type: ['number', 'null'] },",
                  "    finalEvaluationScore: { type: ['number', 'null'] },",
                  "    noteType:             { type: 'string' },",
                  "    subjectId:            { type: 'integer' },",
                  "    pulseNoteRelation:    { type: 'string' },",
                  "    notePrivacy:          { type: 'string' },",
                  "    createdAt:            { type: 'string' },",
                  "    createdBy:            { type: 'integer' },",
                  "    updatedAt:            { type: ['string', 'null'] },",
                  "    deletedAt:            { type: ['string', 'null'] },",
                  "    noteStatus:           { type: 'string' }",
                  "  }",
                  "};",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['data'],",
                  "  properties: { data: { type: 'array', items: noteSchema } }",
                  "};",
                  "pm.test(\"Response matches schema\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "pm.test(\"All returned notes are EXPECTATION type\", function () {",
                  "    pm.response.json().data.forEach(function (note) {",
                  "        pm.expect(note.noteType).to.equal('EXPECTATION');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
