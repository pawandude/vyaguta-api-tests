    {
      "name": "Pulse Write Operations",
      "item": [
        {
          "name": "Create feedback note returns 200 with note ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pulse/notes/feedback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pulse",
                "notes",
                "feedback"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"subjectId\":15444,\"noteType\":\"FEEDBACK\",\"note\":\"[TEST] Automated feedback note\",\"noteStatus\":\"ACTIVE\",\"notePrivacy\":\"ONLY_ME\",\"areaId\":4}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['message', 'data'],",
                  "  properties: {",
                  "    message: { type: 'string' },",
                  "    data: { type: 'object', required: ['id'], properties: { id: { type: 'integer' } } }",
                  "  }",
                  "};",
                  "pm.test('Response matches schema', function () { pm.response.to.have.jsonSchema(schema); });",
                  "pm.test('Note ID stored for subsequent requests', function () {",
                  "    const id = pm.response.json().data.id;",
                  "    pm.environment.set('pulseNoteId', id);",
                  "    pm.expect(id).to.be.a('number').and.above(0);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update feedback note returns 200 with updated note",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pulse/notes/feedback/{{pulseNoteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pulse",
                "notes",
                "feedback",
                "{{pulseNoteId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"note\":\"[TEST] Updated feedback note\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response echoes updated note text', function () {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d.note).to.equal('[TEST] Updated feedback note');",
                  "    pm.expect(d.id).to.equal(pm.environment.get('pulseNoteId'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
