      "item": [
        {
          "name": "Create reminder returns 201 with reminder data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/core/reminders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "reminders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"[TEST] Auto reminder\",\"description\":\"Created by automated test\",\"redirectUrl\":\"https://dev.vyaguta.lftechnology.com.np\",\"startDate\":\"2026-10-07T00:00:00.000Z\",\"endDate\":\"2026-10-08T00:00:00.000Z\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const schema = {",
                  "  type: 'object', required: ['data'],",
                  "  properties: { data: { type: 'object',",
                  "    required: ['id','title','description','redirectUrl','startDate','endDate'],",
                  "    properties: {",
                  "      id:          { type: 'integer' },",
                  "      title:       { type: 'string' },",
                  "      description: { type: 'string' },",
                  "      redirectUrl: { type: 'string' },",
                  "      startDate:   { type: 'string' },",
                  "      endDate:     { type: 'string' },",
                  "      createdBy:   { type: 'integer' }",
                  "    }",
                  "  }}",
                  "};",
                  "pm.test('Response matches schema', function () { pm.response.to.have.jsonSchema(schema); });",
                  "pm.test('Response echoes submitted title and description', function () {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d.title).to.equal('[TEST] Auto reminder');",
                  "    pm.expect(d.description).to.equal('Created by automated test');",
                  "});",
                  "pm.test('Reminder ID stored for subsequent requests', function () {",
                  "    const id = pm.response.json().data.id;",
                  "    pm.environment.set('reminderId', id);",
                  "    pm.expect(id).to.be.a('number').and.above(0);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
