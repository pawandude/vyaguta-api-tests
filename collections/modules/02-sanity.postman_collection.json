{
  "info": {
    "name": "Vyaguta — Sanity",
    "description": "Module tests: Sanity. Part of the Vyaguta API test suite.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Sanity",
      "description": "One representative request per module. Asserts status 200, Content-Type, and non-empty body only. Run on every PR/push for fast feedback.",
      "item": [
        {
          "name": "People — users list is reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/core/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "core",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type is application/json\", function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
                  "pm.test(\"Response body has data property\", function () { pm.expect(pm.response.json()).to.have.property('data'); });"
                ]
              }
            }
          ]
        },
        {
