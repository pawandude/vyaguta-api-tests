  "item": [
    {
      "name": "Team",
      "description": "Tests for the Team module — /api/teams/status-types, /api/teams/projects/summary, /api/teams/projects/missing, /api/teams/projects/feed, /api/teams/projects/health-trend.",
      "item": [
        {
          "name": "Get project status types returns 200 with list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/teams/status-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teams",
                "status-types"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['data'],",
                  "  properties: {",
                  "    data: {",
                  "      type: 'array',",
                  "      items: {",
                  "        type: 'object',",
                  "        required: ['id', 'name'],",
                  "        properties: {",
                  "          id:   { type: 'integer' },",
                  "          name: { type: 'string' }",
                  "        }",
                  "      }",
                  "    }",
                  "  }",
                  "};",
                  "pm.test(\"Response matches schema\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "pm.test(\"data array is not empty\", function () {",
                  "    pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get projects summary returns 200 with status breakdown",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/teams/projects/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teams",
                "projects",
                "summary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['status', 'category', 'industry', 'recentProjects'],",
                  "  properties: {",
                  "    status: {",
                  "      type: 'array',",
                  "      items: {",
                  "        type: 'object',",
                  "        required: ['id', 'name', 'count'],",
                  "        properties: {",
                  "          id:    { type: ['integer', 'null'] },",
                  "          name:  { type: ['string', 'null'] },",
                  "          count: { type: 'integer' }",
                  "        }",
                  "      }",
                  "    },",
                  "    category:       { type: 'array' },",
                  "    industry:       { type: 'array' },",
                  "    recentProjects: {",
                  "      type: 'array',",
                  "      items: {",
                  "        type: 'object',",
                  "        required: ['id', 'name', 'status', 'updatedAt'],",
                  "        properties: {",
                  "          id:        { type: 'integer' },",
                  "          name:      { type: 'string' },",
                  "          status:    { type: 'string' },",
                  "          updatedAt: { type: 'string' }",
                  "        }",
                  "      }",
                  "    }",
                  "  }",
                  "};",
                  "pm.test(\"Response matches schema\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "pm.test(\"status array is not empty\", function () {",
                  "    pm.expect(pm.response.json().status).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get projects summary filtered by statusId returns matching results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/teams/projects/summary?statusId=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teams",
                "projects",
                "summary"
              ],
              "query": [
                {
                  "key": "statusId",
                  "value": "4"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has status, category, industry, recentProjects\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.all.keys('status', 'category', 'industry', 'recentProjects');",
                  "});"
                ]
              }
            }
          ]
        },
